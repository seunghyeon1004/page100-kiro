# HTTP port. A host such as Render may set it itself.
PORT=3000

# AI editor key. Empty: the rule-based compiler publishes every page.
ANTHROPIC_API_KEY=

# Model id for the AI editor.
EDITOR_MODEL=claude-opus-5-5

# Hard cap on model calls per UTC day, per process (0 to 10000).
MAX_MODEL_CALLS_PER_DAY=60

# Hard cap on model calls per process start (0 to 10000).
EDITOR_MAX_CALLS_PER_BOOT=30

# Milliseconds the process must be up before the first edition may call the model.
EDITOR_BOOT_DELAY_MS=600000

# Minimum milliseconds between the starts of two editions.
EDITOR_MIN_INTERVAL_MS=10800000

# anthropic, fixtures or off. Without a key, anthropic means no AI editor.
EDITOR_CLIENT=anthropic

# on fetches the sources on their schedule; off serves the boot snapshot only.
REFRESH=on

# Public https origin with no path, sent in the User-Agent. Empty: not sent.
PUBLIC_ORIGIN=
